# Local dev defaults (this file is committed; real secrets live in .env, which is git-ignored).
REACT_APP_BACKEND_URL=http://localhost:8000
PORT=3000
BROWSER=none
# Set to "true" to enable webpack health-check plugin + endpoints
ENABLE_HEALTH_CHECK=false

# --- Production (Hostinger env panel, NOT this file) ---
# REACT_APP_BACKEND_URL=https://api.plantstiksbottle.in  (never localhost: baked into JS at build time)
# PORT=3000 (or the platform-injected PORT)
# BROWSER=none
# ENABLE_HEALTH_CHECK=false
# GENERATE_SOURCEMAP=false
# See frontend/.env.production.example + DEPLOY_HOSTINGER.md.
