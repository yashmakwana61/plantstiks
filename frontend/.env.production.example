# Production frontend env. Baked into the build at `npm run build` time (CRA inlines REACT_APP_*).
# Build on the deploy machine with real values; never rely on frontend/.env (localhost).
# Example: REACT_APP_BACKEND_URL=https://api.plantstiksbottle.in npm run build
REACT_APP_BACKEND_URL=https://api.plantstiksbottle.in
# Keep source maps out of public hosting:
GENERATE_SOURCEMAP=false
