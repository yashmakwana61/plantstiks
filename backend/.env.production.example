# Production backend env. Copy to backend/.env.production on the VPS ONLY (never commit).
# Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Authenticated internal URL is injected by docker-compose.prod.yml; keep this as fallback/doc:
MONGO_URL=mongodb://plantstiks_app:<strong-password>@mongo:27017/plantstiks?authSource=admin
MONGO_ROOT_USER=plantstiks_app
MONGO_ROOT_PASSWORD=CHANGE-ME-long-random
DB_NAME=plantstiks

# 32+ random chars, unique per environment:
JWT_SECRET=CHANGE-ME-generate-with-secrets-token_urlsafe-48

# No localhost here. Comma-separated, exact origins:
CORS_ORIGINS=https://www.plantstiksbottle.in,https://plantstiksbottle.in

# Seeded once on first boot only (change immediately after first login):
ADMIN_EMAIL=admin@plantstiksbottle.in
ADMIN_PASSWORD=CHANGE-ME-strong-initial-password

# prod behaviour toggles (read by server.py):
ENV=production
TRUSTED_HOSTS=www.plantstiksbottle.in,plantstiksbottle.in,api.plantstiksbottle.in
SECURE_COOKIES=true

# Object storage (optional; app fails open if unset):
# EMERGENT_LLM_KEY=
# INTEGRATION_PROXY_URL=https://integrations.emergentagent.com

# Uvicorn workers (2-4x vCPU):
UVICORN_WORKERS=2
